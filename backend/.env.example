# Server
PORT=5000
NODE_ENV=development

# Frontend URLs allowed to call this API
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_ALT=http://localhost:3001

# Clerk server credentials. Copy these values from the same Clerk application
# used by NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in the frontend.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Firebase
FIREBASE_PROJECT_ID=techtree-studies
